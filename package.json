{
  "name": "context-locker-sync",
  "version": "0.1.0",
  "description": "Context Locker's setup steps, sync scripts and compilers: what each AI app's files should hold, and the script that writes them",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "build:cli": "node cli/scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p cli/tsconfig.json",
    "test": "tsx --test \"test/**/*.test.ts\" && npm run test:cli",
    "test:cli": "cd cli && tsx --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  }
}
